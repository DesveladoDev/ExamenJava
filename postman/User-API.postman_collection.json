{
  "info": {
    "_postman_id": "c752de0d-8479-42af-bc31-f72b17821a6d",
    "name": "User API",
    "description": "Postman collection for the Chakray Java REST API exercise.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const users = pm.response.json();",
                  "if (users.length > 0) {",
                  "    pm.collectionVariables.set(\"userId\", users[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "Sort users by name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?sortedBy=name",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "sortedBy",
                  "value": "name"
                }
              ]
            }
          }
        },
        {
          "name": "Filter name contains user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?filter=name%20co%20user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "name co user"
                }
              ]
            }
          }
        },
        {
          "name": "Filter email ends with mail.com",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?filter=email%20ew%20mail.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "email ew mail.com"
                }
              ]
            }
          }
        },
        {
          "name": "Filter phone starts with country code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?filter=phone%20sw%20%2B52",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "phone sw +52"
                }
              ]
            }
          }
        },
        {
          "name": "Filter tax_id equals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?filter=tax_id%20eq%20AARR990101XXX",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "tax_id eq AARR990101XXX"
                }
              ]
            }
          }
        },
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const user = pm.response.json();",
                  "pm.collectionVariables.set(\"userId\", user.id);",
                  "",
                  "pm.test(\"Password is not returned\", function () {",
                  "    pm.expect(user).not.to.have.property(\"password\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman@mail.com\",\n  \"name\": \"postman-user\",\n  \"phone\": \"+52 55 1111 2222\",\n  \"password\": \"postman-password\",\n  \"tax_id\": \"POMT960404XXX\",\n  \"addresses\": [\n    {\n      \"id\": 1,\n      \"name\": \"homeaddress\",\n      \"street\": \"Postman Street 1\",\n      \"country_code\": \"MX\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "Create user with duplicate tax_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"duplicate@mail.com\",\n  \"name\": \"duplicate-user\",\n  \"phone\": \"+52 55 3333 4444\",\n  \"password\": \"password\",\n  \"tax_id\": \"AARR990101XXX\",\n  \"addresses\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "Patch user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Name was updated\", function () {",
                  "    pm.expect(pm.response.json().name).to.eql(\"updated-user\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"updated-user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Patch user with invalid phone",
          "event": [
            {
              "listen": "test",
              "script": {
